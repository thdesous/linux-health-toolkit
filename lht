#!/usr/bin/env bash

readonly VERSION="0.1.0"

show_banner() {
    echo "Linux Health Toolkit"
    echo
}

show_version() {
    echo "${VERSION}"
}

show_help() {
    cat << EOF
Linux Health Toolkit

Usage:
  lht [OPTIONS]

Options:
  --help       Show help
  --version    Show version
EOF
}

show_system_info() {
    echo "System Information"
    echo "------------------"

    local hostname
    hostname=$(hostname)

    local kernel
    kernel=$(uname -r)

    local uptime
    uptime=$(uptime -p)

    local os
    os=$(grep "^PRETTY_NAME=" /etc/os-release | cut -d '"' -f2)

    printf "%-12s %s\n" "Hostname:" "$hostname"
    printf "%-12s %s\n" "OS:" "$os"
    printf "%-12s %s\n" "Kernel:" "$kernel"
    printf "%-12s %s\n" "Uptime:" "$uptime"
}

run_assessment() {
    show_system_info
}

main() {
    case "${1:-}" in
        --help)
            show_help
            ;;
        --version)
            show_version
            ;;
        *)
            show_banner
            run_assessment
            ;;
    esac
}

main "$@"