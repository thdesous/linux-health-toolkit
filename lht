#!/usr/bin/env bash

readonly VERSION="0.1.0"

show_banner() {
    echo "Linux Health Toolkit"
    echo
}

show_version() {
    echo "${VERSION}"
}

show_help() {
    cat << EOF
Linux Health Toolkit

Usage:
  lht [OPTIONS]

Options:
  --help       Show help
  --version    Show version
EOF
}

show_system_info() {
    echo "System Information"
    echo "------------------"

    local hostname
    hostname=$(hostname)

    local kernel
    kernel=$(uname -r)

    local uptime
    uptime=$(uptime -p)

    local os
    os=$(grep "^PRETTY_NAME=" /etc/os-release | cut -d '"' -f2)

    printf "%-12s %s\n" "Hostname:" "$hostname"
    printf "%-12s %s\n" "OS:" "$os"
    printf "%-12s %s\n" "Kernel:" "$kernel"
    printf "%-12s %s\n" "Uptime:" "$uptime"
}

show_cpu_metrics() {
    echo
    echo "CPU Metrics"
    echo "-----------"

    local cpu_line_1
    local cpu_line_2

    cpu_line_1=$(grep "^cpu " /proc/stat)
    sleep 1
    cpu_line_2=$(grep "^cpu " /proc/stat)

    local idle_1 total_1
    local idle_2 total_2

    idle_1=$(echo "$cpu_line_1" | awk '{print $5}')
    total_1=$(echo "$cpu_line_1" | awk '{sum=0; for(i=2;i<=NF;i++) sum+=$i; print sum}')

    idle_2=$(echo "$cpu_line_2" | awk '{print $5}')
    total_2=$(echo "$cpu_line_2" | awk '{sum=0; for(i=2;i<=NF;i++) sum+=$i; print sum}')

    local idle_delta total_delta

    idle_delta=$((idle_2-idle_1))
    total_delta=$((total_2-total_1))

    local cpu_usage

    cpu_usage=$(awk "BEGIN { printf \"%.2f\", (1 - $idle_delta / $total_delta) * 100 }")

    local cpu_cores
    cpu_cores=$(nproc)

    local load_1 load_5 load_15
    read -r load_1 load_5 load_15 _ < /proc/loadavg

    printf "%-12s %s%%\n" "CPU Usage:" "$cpu_usage"
    printf "%-12s %s\n" "CPU Cores:" "$cpu_cores"
    printf "%-12s %s | %s | %s\n" \
        "Load Avg (1m, 5m, 15m):" \
        "$load_1" \
        "$load_5" \
        "$load_15"
}

show_memory_metrics() {
    echo
    echo "Memory Metrics"
    echo "--------------"

    local mem_total
    local mem_available
    local mem_used

    mem_total=$(grep "^MemTotal:" /proc/meminfo | awk '{print $2}')
    mem_available=$(grep "^MemAvailable:" /proc/meminfo | awk '{print $2}')

    mem_used=$((mem_total - mem_available))

    local mem_usage

    mem_usage=$(awk "BEGIN { printf \"%.2f\", ($mem_used / $mem_total) * 100 }")

    local total_mb
    local used_mb
    local available_mb

    total_mb=$((mem_total / 1024))
    used_mb=$((mem_used / 1024))
    available_mb=$((mem_available / 1024))

    printf "%-18s %s MB\n" "Memory Total:" "$total_mb"
    printf "%-18s %s MB\n" "Memory Used:" "$used_mb"
    printf "%-18s %s MB\n" "Memory Available:" "$available_mb"
    printf "%-18s %s%%\n" "Memory Usage:" "$mem_usage"
}

show_disk_metrics() {
    echo
    echo "Disk Metrics"
    echo "------------"

    local disk_info

    disk_info=$(df -h / | awk 'NR==2')

    local filesystem
    local total
    local used
    local available
    local usage

    filesystem=$(echo "$disk_info" | awk '{print $1}')
    total=$(echo "$disk_info" | awk '{print $2}')
    used=$(echo "$disk_info" | awk '{print $3}')
    available=$(echo "$disk_info" | awk '{print $4}')
    usage=$(echo "$disk_info" | awk '{print $5}')

    printf "%-18s %s\n" "Filesystem:" "$filesystem"
    printf "%-18s %s\n" "Disk Total:" "$total"
    printf "%-18s %s\n" "Disk Used:" "$used"
    printf "%-18s %s\n" "Disk Available:" "$available"
    printf "%-18s %s\n" "Disk Usage:" "$usage"

}

run_assessment() {
    show_system_info
    show_cpu_metrics
    show_memory_metrics
    show_disk_metrics
}

main() {
    case "${1:-}" in
        --help)
            show_help
            ;;
        --version)
            show_version
            ;;
        *)
            show_banner
            run_assessment
            ;;
    esac
}

main "$@"