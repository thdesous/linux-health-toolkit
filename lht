#!/usr/bin/env bash

readonly VERSION="0.1.0"

show_banner() {
    echo "Linux Health Toolkit"
    echo
}

show_version() {
    echo "${VERSION}"
}

show_help() {
    cat << EOF
Linux Health Toolkit

Usage:
  lht [OPTIONS]

Options:
  --help       Show help
  --version    Show version
EOF
}

show_system_info() {
    echo "# SYSTEM INFORMATION"
    echo "--------------------"

    local hostname
    hostname=$(hostname)

    local kernel
    kernel=$(uname -r)

    local uptime
    uptime=$(uptime -p)

    local os
    os=$(grep "^PRETTY_NAME=" /etc/os-release | cut -d '"' -f2)

    printf "%-12s %s\n" "Hostname:" "$hostname"
    printf "%-12s %s\n" "OS:" "$os"
    printf "%-12s %s\n" "Kernel:" "$kernel"
    printf "%-12s %s\n" "Uptime:" "$uptime"
}

show_cpu_metrics() {
    echo
    echo "# SYSTEM METRICS"
    echo "----------------"
    echo "CPU Metrics"
    echo "-----------"

    local cpu_line_1
    local cpu_line_2

    cpu_line_1=$(grep "^cpu " /proc/stat)
    sleep 1
    cpu_line_2=$(grep "^cpu " /proc/stat)

    local idle_1 total_1
    local idle_2 total_2

    idle_1=$(echo "$cpu_line_1" | awk '{print $5}')
    total_1=$(echo "$cpu_line_1" | awk '{sum=0; for(i=2;i<=NF;i++) sum+=$i; print sum}')

    idle_2=$(echo "$cpu_line_2" | awk '{print $5}')
    total_2=$(echo "$cpu_line_2" | awk '{sum=0; for(i=2;i<=NF;i++) sum+=$i; print sum}')

    local idle_delta total_delta

    idle_delta=$((idle_2-idle_1))
    total_delta=$((total_2-total_1))

    local cpu_usage

    cpu_usage=$(awk "BEGIN { printf \"%.2f\", (1 - $idle_delta / $total_delta) * 100 }")

    local cpu_cores
    cpu_cores=$(nproc)

    local load_1 load_5 load_15
    read -r load_1 load_5 load_15 _ < /proc/loadavg

    printf "%-12s %s%%\n" "CPU Usage:" "$cpu_usage"
    printf "%-12s %s\n" "CPU Cores:" "$cpu_cores"
    printf "%-12s %s | %s | %s\n" \
        "Load Avg (1m, 5m, 15m):" \
        "$load_1" \
        "$load_5" \
        "$load_15"
}

show_memory_metrics() {
    echo
    echo "Memory Metrics"
    echo "--------------"

    local mem_total
    local mem_available
    local mem_used

    mem_total=$(grep "^MemTotal:" /proc/meminfo | awk '{print $2}')
    mem_available=$(grep "^MemAvailable:" /proc/meminfo | awk '{print $2}')

    mem_used=$((mem_total - mem_available))

    local mem_usage

    mem_usage=$(awk "BEGIN { printf \"%.2f\", ($mem_used / $mem_total) * 100 }")

    local total_mb
    local used_mb
    local available_mb

    total_mb=$((mem_total / 1024))
    used_mb=$((mem_used / 1024))
    available_mb=$((mem_available / 1024))

    printf "%-18s %s MB\n" "Memory Total:" "$total_mb"
    printf "%-18s %s MB\n" "Memory Used:" "$used_mb"
    printf "%-18s %s MB\n" "Memory Available:" "$available_mb"
    printf "%-18s %s%%\n" "Memory Usage:" "$mem_usage"

    echo
    echo "Swap Metrics"
    echo "--------------"

    local swap_total
    local swap_free
    local swap_used
    local swap_usage

    swap_total=$(grep "^SwapTotal:" /proc/meminfo | awk '{print $2}')
    swap_free=$(grep "^SwapFree:" /proc/meminfo | awk '{print $2}')

    swap_used=$((swap_total - swap_free))

    local swap_total_mb
    local swap_used_mb
    local swap_free_mb

    swap_total_mb=$((swap_total / 1024))
    swap_used_mb=$((swap_used / 1024))
    swap_free_mb=$((swap_free / 1024))

    if [ "$swap_total" -gt 0 ]; then
        swap_usage=$(awk "BEGIN { printf \"%.2f\", ($swap_used / $swap_total) * 100 }")
    else
        swap_usage="0.00"
    fi

    printf "%-18s %s MB\n" "Swap Total:" "$swap_total_mb"
    printf "%-18s %s MB\n" "Swap Used:" "$swap_used_mb"
    printf "%-18s %s MB\n" "Swap Free:" "$swap_free_mb"
    printf "%-18s %s%%\n" "Swap Usage:" "$swap_usage"
}

show_disk_metrics() {
    echo
    echo "Disk Metrics"
    echo "------------"

    local disk_info

    disk_info=$(df -h / | awk 'NR==2')

    local filesystem
    local total
    local used
    local available
    local usage

    filesystem=$(echo "$disk_info" | awk '{print $1}')
    total=$(echo "$disk_info" | awk '{print $2}')
    used=$(echo "$disk_info" | awk '{print $3}')
    available=$(echo "$disk_info" | awk '{print $4}')
    usage=$(echo "$disk_info" | awk '{print $5}')

    printf "%-18s %s\n" "Filesystem:" "$filesystem"
    printf "%-18s %s\n" "Disk Total:" "$total"
    printf "%-18s %s\n" "Disk Used:" "$used"
    printf "%-18s %s\n" "Disk Available:" "$available"
    printf "%-18s %s\n" "Disk Usage:" "$usage"

    echo
    echo "Mounted Filesystems"
    echo "-------------------"

    df -h --output=source,size,used,avail,pcent,target \
    | grep -E '^Filesystem|^/dev/|^[A-Z]:\\'
}

show_top_processes() {
    echo
    echo "# SYSTEM PROCESSES"
    echo "------------------"
    echo "Top CPU Processes"
    echo "-----------------"

    printf "%-8s %-6s %-10s %-8s %s\n" \
        "PID" "CPU%" "USER" "START" "COMMAND"

    ps -eo pid,%cpu,user,start,args --sort=-%cpu \
        | head -n 6 \
        | tail -n 5 \
        | awk '{
            cmd="";
            for(i=5;i<=NF;i++) cmd=cmd $i " ";

            if(length(cmd) > 60)
                cmd=substr(cmd,1,60)"...";

            printf "%-8s %-6s %-10s %-8s %s\n",
                $1,$2,$3,$4,cmd
        }'

    echo
    echo "Top Memory Processes"
    echo "--------------------"

    printf "%-8s %-6s %-10s %-8s %s\n" \
        "PID" "MEM%" "USER" "START" "COMMAND"

    ps -eo pid,%mem,user,start,args --sort=-%mem \
        | head -n 6 \
        | tail -n 5 \
        | awk '{
            cmd="";
            for(i=5;i<=NF;i++) cmd=cmd $i " ";

            if(length(cmd) > 60)
                cmd=substr(cmd,1,60)"...";

            printf "%-8s %-6s %-10s %-8s %s\n",
                $1,$2,$3,$4,cmd
        }'
}

run_assessment() {
    show_system_info
    show_cpu_metrics
    show_memory_metrics
    show_disk_metrics
    show_top_processes
}

main() {
    case "${1:-}" in
        --help)
            show_help
            ;;
        --version)
            show_version
            ;;
        *)
            show_banner
            run_assessment
            ;;
    esac
}

main "$@"